# /etc/onlinetest/api.env — fayl huqufi: root:root 600
# Parollarni chatga yozmang; kalitlarni faqat serverda yarating.
#
# HTTPS (ikki domen: frontend + API): barcha URL lar https://; CORS da faqat frontend domeni.
# TLS ni nginx bajaradi — DJANGO_SECURE_SSL=1 qo‘ymang (redirect loop).
# Certbot: sudo bash deploy/https-certbot.sh FRONT_DOMEN API_DOMEN

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# PostgreSQL — MAJBURIY (SQLite qo'llab-quvvatlanmaydi):
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/onlinetest
# DB_CONN_MAX_AGE=60
# DATABASE_SSL_REQUIRE=1
APP_BUILD_REF=
# API tinglash (systemd unitda ham GUNICORN_BIND beriladi; bu yerda qayta yozmaslik mumkin)
# GUNICORN_BIND=127.0.0.1:9081
# Nginx: proxy_set_header Host $host; bo‘lsa va domen ishonchli bo‘lsa
# TRUST_X_FORWARDED_HOST=1
# LOG_JSON=1
# Asosiy prod domen (hozirgi server): appi.online-imtixon.uz (bir vhost, SPA+API).
# Ikkita domen (online-imtixon.uz + api.…): deploy/nginx/onlinetest.conf + quyidagi ro‘yxatga qo‘shing.
ALLOWED_HOSTS=appi.online-imtixon.uz,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://appi.online-imtixon.uz
# CORS dagi domenlar settings.py da CSRF_TRUSTED_ORIGINS ga ham qo‘shiladi (fayl yuklash POST 403).
CORS_ALLOWED_ORIGINS=https://appi.online-imtixon.uz
# Frontend to‘g‘ridan-to‘g‘ri API domeniga murojaat qilsa: VITE_API_BASE_URL=https://appi.online-imtixon.uz

JWT_SECRET=

# VAC (Virtual Anti-Cheat) — prod da default yoqilgan; o‘chirish uchun 0 qo‘ying.
# VAC_HMAC_GUARD=1
# VAC_SEQ_GUARD=1
# VAC_CHALLENGE_GUARD=1
# VAC_DEVICE_LOCK=1
# VAC_PC_ONLY=1
# VAC_HMAC_MAX_DRIFT_SEC=90
# IDENTITY_VERIFY_REQUIRED=1
# IDENTITY_VERIFY_MAX_AGE_SEC=1800
# EXAM_MIN_SUBMIT_SECONDS=30
# VAC_CACHE_DIR=/var/www/onlinetest/backend/vac_cache

# Redis — bir nechta Gunicorn worker (WEB_CONCURRENCY>1) bo'lsa MAJBURIY:
#   • Jonli proctoring (WebSocket / LiveMonitor) worker'lar orasida ishlashi uchun (channel layer).
#   • VAC HMAC replay cache FileBased o'rniga Redis'da (tezroq, race'siz).
# O'rnatish:  sudo apt install redis-server && sudo systemctl enable --now redis-server
REDIS_URL=redis://127.0.0.1:6379/0


# Yuzni solishtirish (talaba identity-compare) — OpenCV SFace embedding (asosiy).
# Birinchi marta API ishga tushganda modellar apps/api/face_models/ ga yuklanadi (yoki deploy bilan nusxalang).
# FACE_MATCH_COSINE_THRESHOLD=0.40
# Ixtiyoriy OpenAI Vision zaxira: FACE_COMPARE_FALLBACK_OPENAI=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MODEL_FALLBACKS=gpt-4o-mini
# Imtihon kadrida telefon/kitob/noutbuk aniqlash (Vision). Default: 1. O'chirish: 0
# PROCTOR_OPENAI_OBJECTS=1

# iMentor tashqi test bazasi (ustozlar yaratgan testlar)
# IMENTOR_API_BASE_URL=https://imentor.devflix.uz/api
# IMENTOR_API_KEY=

# Bir martalik superadmin
# (api.env da SUPERADMIN_PASSWORD bo‘lishi kerak; parolni chatga yozmang)
SUPERADMIN_PASSWORD=
# SUPERADMIN_ID=superadmin

# bootstrap_exam: prod da ADMIN_BOOTSTRAP_PASSWORD majburiy (kamida 12 belgi). bootstrap-ubuntu-once.sh avto yaratadi.
# ADMIN_BOOTSTRAP_ID=fjstiadmin
# ADMIN_BOOTSTRAP_PASSWORD=

# Bir martalik demo loginlar: python manage.py seed_demo_users
# DEBUG=0: DEMO_SEED_PASSWORD majburiy (≥12). Keyin o‘chiring yoki parolni almashtiring.
# DEMO_SEED_PASSWORD=

# JWT muddati (soat, 1–168, standart 24)
# JWT_EXPIRE_HOURS=24

PUBLIC_APP_URL=https://appi.online-imtixon.uz
# Docker Compose host port (nginx proxy_pass bilan bir xil): APP_PORT=8090
# Parolda @ bo‘lsa DATABASE_URL ni URL-encode qiling (@@ → %40%40) yoki maxsus belgisiz parol ishlating.
# TLS nginx da; Django ichki HTTP — SSL redirect Django da yoqilmasin (loop bo‘lishi mumkin).
SECURE_PROXY_SSL_HEADER=X-Forwarded-Proto:https
